# Keycloak Server, ohne trailing slash, z.B. https://keycloak.example.com
KEYCLOAK_HOST=https://kchost:8443

# Realm, der sowohl den Client als auch die Nutzer enthält
KEYCLOAK_REALM=myrealm

# Client-ID und Secret des Clients mit "Client authentication" = on
# und Service-Account-Rollen "view-users"/"query-users" (Client: realm-management)
KEYCLOAK_CLIENT_ID=xxxx
KEYCLOAK_CLIENT_SECRET=xxxx

# Optional: bei selbstsigniertem Zertifikat auf false setzen
KEYCLOAK_VERIFY_SSL=false

# --- Für keycloak_db_users.py (direkter DB-Zugriff) ---
# JDBC-URL aus deiner systemd-Unit, OHNE "Environment=" Präfix,
# ggf. mit mehreren Hosts kommagetrennt (wie bei euch: HA-Setup)
KC_DB_URL=jdbc:postgresql://dbhost:5432/kc01n1
KC_DB_USERNAME=xxxx
KC_DB_PASSWORD=xxxx

# Optional, falls die DB SSL erfordert: disable/allow/prefer/require/verify-ca/verify-full
KC_DB_SSLMODE=prefer